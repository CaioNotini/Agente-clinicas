# Copie para .env (cp .env.example .env). O .env nunca vai para o Git.
# Todos os valores abaixo sao ficticios e servem para o ambiente local.

# Banco local do Docker Compose
DB_HOST=localhost
DB_PORT=5434
DB_NAME=agente_estudo

# Superusuario criado pelo container na primeira subida.
# Usado so pelas migrations (Alembic) e pela administracao, nunca pela aplicacao.
DB_USER=dev_admin
DB_PASSWORD=senha-ficticia-admin

# Conta da aplicacao, sujeita ao RLS. O nome precisa ser exatamente app_clinicas.
# A senha e aplicada por: python -m scripts.definir_senhas
APP_DB_USER=app_clinicas
APP_DB_PASSWORD=senha-ficticia-app

# Conta do worker de jobs (BYPASSRLS, so a fila). O nome precisa ser exatamente worker_jobs.
# A senha e aplicada por: python -m scripts.definir_senhas
WORKER_DB_USER=worker_jobs
WORKER_DB_PASSWORD=senha-ficticia-worker
